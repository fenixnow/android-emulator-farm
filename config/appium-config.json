{
  "server": {
    "address": "0.0.0.0",
    "port": 4723,
    "base-path": "/wd/hub",
    "allow-cors": true,
    "session-override": false,
    "allow-insecure": ["uiautomator2:adb_shell"],
    "local-timezone": true,
    "log-level": "info",
    "log": "/var/log/appium/appium-farm.log",
    "use-plugins": ["device-farm"],
    "plugin": {
      "device-farm": {
        "platform": "android",
        "enableAuthentication": true,
        "newCommandTimeoutSec": 180
      }
    }
  }
}
